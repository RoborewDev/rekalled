# Copy to .env and adjust: `cp .env.example .env`. .env is gitignored; this file is committed.
# Real environment variables always win over values in .env.

# development | test | production
ENV=development

# Required. dev = no login, every request is a fixed local user (X-Dev-User picks another).
# dev is refused unless ENV is development or test. logto = validate Logto access tokens.
AUTH_MODE=dev
# Required when AUTH_MODE=logto (all three), unused in dev mode.
LOGTO_ENDPOINT=
LOGTO_API_RESOURCE=
LOGTO_APP_ID=
# Host port the Compose Postgres is published on (the container stays on 5432).
# Compose binds it to 127.0.0.1 only, so it is not reachable from your network.
POSTGRES_HOST_PORT=5433

# Credentials used to initialise the Compose Postgres.
# POSTGRES_PASSWORD is required - `docker compose up` fails if it is missing.
# Keep it in sync with the password inside DATABASE_URL (URL-encode special chars).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rekalled

# Connection string used by the API and Alembic. Required: there is no default.
DATABASE_URL=postgresql+asyncpg://postgres:change-me@localhost:5433/rekalled

# Connection string used by pytest (database is created by infra/db/init.sql).
# Required for tests, and the database name must end in _test.
TEST_DATABASE_URL=postgresql+asyncpg://postgres:change-me@localhost:5433/rekalled_test

# Card generation. fake = deterministic cards, no API key (dev, E2E).
# ai = the real model. With a gateway/ AI_MODEL it requires PYDANTIC_AI_GATEWAY_API_KEY,
# and the app refuses to start without it.
CARD_GENERATOR=ai
# A Pydantic AI model string; gateway/ routes through Pydantic AI Gateway.
AI_MODEL=gateway/openai:gpt-5.4-mini
# Secret. Required when CARD_GENERATOR=ai and AI_MODEL starts with gateway/.
# Never commit a real key. Direct models (e.g. openai:gpt-4o) read their own variable
# from the process environment instead: export OPENAI_API_KEY, because .env is loaded
# into Settings, not into the environment the provider reads.
PYDANTIC_AI_GATEWAY_API_KEY=
# Pasted text above this many characters is rejected (413).
MAX_SOURCE_CHARS=20000
MAX_CARDS=20
# Each Source spends model credit: a per-user cap over the last 24 hours (429 when reached).
MAX_SOURCES_PER_DAY=50

# Spaced repetition. Fuzzing spreads due dates a little so cards do not bunch up.
FSRS_FUZZING=true
NEW_CARDS_PER_SESSION=10
DUE_CARDS_PER_SESSION=200
