# Copy to .env and adjust. .env is gitignored; this file is committed.

# Host port the Compose Postgres is published on (the container stays on 5432).
POSTGRES_HOST_PORT=5433

# Credentials used to initialise the Compose Postgres.
# POSTGRES_PASSWORD is required - `docker compose up` fails if it is missing.
# Keep it in sync with the password inside DATABASE_URL (URL-encode special chars).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rekalled

# Connection string used by the API and Alembic.
DATABASE_URL=postgresql+asyncpg://postgres:change-me@localhost:5433/rekalled

# Connection string used by pytest (database is created by infra/db/init.sql).
TEST_DATABASE_URL=postgresql+asyncpg://postgres:change-me@localhost:5433/rekalled_test
