**/.venv
**/__pycache__
**/.pytest_cache
**/.ruff_cache
**/.mypy_cache
**/.output
**/.nitro
**/.tanstack
**/dist
**/coverage
**/e2e
**/test-results
**/playwright-report
.env
.env.*
**/.env
**/.env.*
